# Ask AI (src/routes/api.chat.ts) calls OpenRouter. These are read at runtime: copy this file to
# .env.local for local development, and set them as environment variables on the container in
# production (see deploy/docker-compose.yml).
OPENROUTER_API_KEY=
# Optional; an OpenRouter model id with tool support. Defaults to anthropic/claude-haiku-5.5.
OPENROUTER_MODEL=
